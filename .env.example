# AURA Environment Configuration
# API Keys
GEMINI_API_KEY=

# Database Configuration
# For local development SQLite is supported out of the box:
# DATABASE_URL=sqlite:///./data/aura.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://aura_user:aura_password@localhost:5432/aura_db
DATABASE_URL=sqlite:///./data/aura.db

# Vector Storage Configuration
# If local embedded Qdrant is preferred, set QDRANT_LOCAL_PATH=./data/qdrant
# If remote Qdrant container/service is running, set QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=aura_papers

# File Storage
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# Gemini Models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Chunking Parameters
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Server
PORT=8000
HOST=0.0.0.0
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
